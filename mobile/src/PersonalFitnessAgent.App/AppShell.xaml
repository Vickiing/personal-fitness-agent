<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="PersonalFitnessAgent.App.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:PersonalFitnessAgent.App"
       Title="Pulso"
       Shell.ForegroundColor="#FFFFFF"
       Shell.TitleColor="#FFFFFF"
       Shell.BackgroundColor="#0B0F14"
       Shell.TabBarBackgroundColor="#0B0F14"
       Shell.TabBarForegroundColor="#FF642D"
       Shell.TabBarTitleColor="#FF642D"
       Shell.TabBarUnselectedColor="#8997A6"
       Shell.NavBarHasShadow="False">
    <TabBar>
        <ShellContent Title="Hoje" Route="today" ContentTemplate="{DataTemplate local:MainPage}" />
        <ShellContent Title="Treinos" Route="workout" ContentTemplate="{DataTemplate local:TrainingSheetPage}" />
        <ShellContent Title="Minha conta" Route="account" ContentTemplate="{DataTemplate local:MorePage}" />
    </TabBar>
</Shell>
