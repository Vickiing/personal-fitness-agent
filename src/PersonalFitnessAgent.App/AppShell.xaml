<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="PersonalFitnessAgent.App.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:PersonalFitnessAgent.App"
       Title="Fitness Agent">
    <TabBar>
        <ShellContent Title="Hoje" Route="today" ContentTemplate="{DataTemplate local:MainPage}" />
        <ShellContent Title="Treino" Route="workout" ContentTemplate="{DataTemplate local:WorkoutPage}" />
        <ShellContent Title="Check-in" Route="checkin" ContentTemplate="{DataTemplate local:CheckInPage}" />
        <ShellContent Title="Restrições" Route="restrictions" ContentTemplate="{DataTemplate local:RestrictionsPage}" />
        <ShellContent Title="Progresso" Route="progress" ContentTemplate="{DataTemplate local:ProgressPage}" />
    </TabBar>
</Shell>
